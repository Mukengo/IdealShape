# Escolha UM provedor gratuito (ou varios, e a funcao usa como fila de reserva).
# Copie para .env.local se for rodar com "vercel dev". NUNCA faca commit da chave.

# Groq — recomendado. Sem cartao, ~30 msg/min e 1000/dia, nao treina com seus dados.
# Pegue em console.groq.com
GROQ_API_KEY=gsk_sua_chave_aqui

# Google Gemini — sem cartao, ~15 msg/min e 1000/dia.
# ATENCAO: o plano gratuito pode usar o que voce envia para treinar modelos.
# Pegue em aistudio.google.com
# GEMINI_API_KEY=AIza_sua_chave_aqui

# OpenRouter — sem cartao, mas so 50 mensagens por dia. Serve de reserva.
# OPENROUTER_API_KEY=sk-or-sua_chave_aqui

# Anthropic — pago por uso. Melhor qualidade.
# ANTHROPIC_API_KEY=sk-ant-sua_chave_aqui

# Opcionais
# PROVEDOR=groq
# MODELO=openai/gpt-oss-120b
